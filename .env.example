# ====================================================================
# Morok Relay — environment configuration
# Copy to .env and fill in actual values. Never commit .env.
# ====================================================================

# === Application ===
MOROK_ENV=development                          # development | production
MOROK_DEBUG=true                               # log SQL queries, verbose errors
MOROK_HOST=0.0.0.0
MOROK_PORT=8000
MOROK_RELAY_NAME=relay1.morok.app              # this relay's domain
MOROK_LOG_LEVEL=INFO                           # DEBUG | INFO | WARNING | ERROR

# === Database (PostgreSQL) ===
MOROK_DB_DSN=postgresql+asyncpg://morok:morok_dev_password@localhost:5432/morok_relay
MOROK_DB_POOL_SIZE=10
MOROK_DB_MAX_OVERFLOW=20

# === Redis ===
MOROK_REDIS_URL=redis://localhost:6379/0
MOROK_REDIS_POOL_SIZE=10

# === Storage ===
# Where encrypted message blobs are written before delivery.
# Must be on a filesystem that supports secure delete (ext4, btrfs).
MOROK_BLOB_DIR=/var/lib/morok/blobs

# === Message TTL ===
# Hard ceiling regardless of user-set TTL. Messages are physically
# destroyed after this many seconds even if not delivered.
MOROK_MESSAGE_TTL_HARD_SECONDS=172800          # 48 hours

# === Federation ===
# This relay's signing keypair (Ed25519) for federation auth.
# Generate with: python -m morok_relay.scripts.generate_relay_keypair
MOROK_RELAY_PUBKEY_HEX=
MOROK_RELAY_PRIVKEY_HEX=

# Known relay registry — used for federation discovery.
# In production this comes from DNS TXT records on morok.app.
# In dev, hardcode a few relays for local testing.
MOROK_KNOWN_RELAYS=relay1.morok.app,relay2.morok.app

# === Security ===
# Maximum message blob size in bytes (encrypted; ~equivalent to 200KB plaintext + overhead).
MOROK_MAX_BLOB_BYTES=262144                    # 256KB

# Rate limits
MOROK_RATE_LIMIT_PER_MIN=60                    # API calls per minute per pubkey
MOROK_RATE_LIMIT_BURST=10                      # burst allowance

# Username constraints
MOROK_USERNAME_MIN_LEN=3
MOROK_USERNAME_MAX_LEN=20
MOROK_USERNAME_COOLDOWN_DAYS=30                # how long after release before reuse allowed
