# ====================================================================
# Morok Relay — environment configuration
# Copy to .env and fill in actual values. Never commit .env.
#
# ПРАВИЛО СИНХРОНУ: кожна змінна тут ЗОБОВ'ЯЗАНА існувати як поле в
# morok_relay/config.py::Settings (env_prefix=MOROK_). Settings має
# extra="ignore", тож помилка в назві НЕ впаде на старті — адмін пропише
# security-ліміт, побачить нормальний запуск і думатиме, що ліміт діє.
# Звірка: python -m tools.check_env_example (ганяти в CI).
# ====================================================================

# === Relay identity ===
MOROK_RELAY_NAME=relay1.morok.app
# Ed25519 федераційна пара. Згенерувати:
#   python -m morok_relay.scripts.generate_relay_keypair
MOROK_RELAY_PUBKEY_HEX=
MOROK_RELAY_PRIVKEY_HEX=
# .onion цього релея (без схеми). Показується у /health, щоб клієнти
# могли перемкнутись на Tor.
MOROK_TOR_ONION_ADDRESS=

# === Mode ===
MOROK_IS_PRODUCTION=true
MOROK_DEBUG=false

# === Database (PostgreSQL) ===
MOROK_DB_DSN=postgresql+asyncpg://morok:morok_dev_password@localhost:5432/morok_relay
MOROK_DB_POOL_SIZE=10
MOROK_DB_MAX_OVERFLOW=5

# === Redis ===
MOROK_REDIS_URL=redis://localhost:6379/0
MOROK_REDIS_POOL_SIZE=20

# === Storage ===
# Куди пишуться зашифровані блоби до доставки.
# ЧЕСНО ПРО SECURE DELETE: overwrite+unlink — best effort. На CoW-ФС
# (btrfs/ZFS) старі блоки живуть до GC, на SSD — до TRIM. Реальна
# гарантія стирання — full-disk encryption (LUKS) + знищення ключа.
# fstrim-таймер (ставиться installer'ом) лише скорочує вікно на SSD.
MOROK_BLOB_DIR=/var/lib/morok/blobs

# === Message TTL / limits ===
# Жорстка стеля незалежно від TTL користувача: конверт фізично
# знищується через стільки секунд, навіть якщо не доставлений.
MOROK_MESSAGE_TTL_HARD_SECONDS=86400
# Максимальний розмір зашифрованого блоба, байт.
MOROK_MAX_BLOB_BYTES=262144
# Скільки днів після звільнення username заборонено брати повторно.
MOROK_USERNAME_COOLDOWN_DAYS=30

# === Rate limiting ===
MOROK_RATE_LIMIT_ENABLED=true
# Проксі, чиїм X-Real-IP / X-Forwarded-For ми віримо. Для всіх інших
# джерел форвардні заголовки ІГНОРУЮТЬСЯ (захист від спуфінгу повз
# nginx). Кома-розділений список. Дефолт: лише loopback.
MOROK_TRUSTED_PROXY_IPS=127.0.0.1,::1
MOROK_RATE_LIMIT_AUTH_PER_MINUTE=10
MOROK_RATE_LIMIT_HANDSHAKE_PER_MINUTE=5
MOROK_RATE_LIMIT_LOOKUP_PER_MINUTE=30
MOROK_RATE_LIMIT_MESSAGES_PER_MINUTE=60
MOROK_RATE_LIMIT_SEALED_PER_MINUTE=30
MOROK_RATE_LIMIT_GROUP_CREATE_PER_MINUTE=5
MOROK_RATE_LIMIT_GROUP_MESSAGES_PER_MINUTE=30
MOROK_RATE_LIMIT_DMS_CREATE_PER_MINUTE=5
MOROK_RATE_LIMIT_WS_CONNECTIONS_PER_PUBKEY=5

# === Admin dashboard ===
# Порожній username = адмінка вимкнена.
MOROK_ADMIN_USERNAME=
# Argon2id-хеш пароля:
#   python -c "import nacl.pwhash; print(nacl.pwhash.str(b'YOURPASS').decode())"
MOROK_ADMIN_PASSWORD_HASH=
MOROK_ADMIN_SESSION_TTL_SECONDS=3600

# === morok.email (mail) ===
MOROK_MAIL_DOMAIN=morok.email
MOROK_MAIL_SMTP_PORT=25
MOROK_MAIL_MAX_BYTES=26214400
MOROK_MAIL_RL_PER_IP=30
MOROK_MAIL_TTL_SECONDS=604800
MOROK_MAIL_ALIAS_START=3
MOROK_MAIL_ALIAS_PER_MONTH=1
MOROK_MAIL_ALIAS_CAP=15
MOROK_MAIL_ADMIN_PUBKEY_HEX=
# Спільний секрет relay1 <-> CX23-воркер (X-Mailout-Token).
MOROK_MAIL_OUT_TOKEN=
# Добовий ліміт вихідних листів на один акаунт.
MOROK_MAIL_OUT_USER_DAILY=20

# === Web push (VAPID) ===
# Порожній публічний ключ = push тихо вимкнено (ендпоінти дають 503).
MOROK_VAPID_PUBLIC_KEY_B64=
MOROK_VAPID_PRIVATE_KEY_PATH=/etc/morok/vapid_private.pem
MOROK_VAPID_SUBJECT=mailto:morok.messenger@protonmail.com

# === FCM (нативні Android-пуші) ===
# Вимкнено, поки файла немає. Service-account JSON з Firebase Console.
MOROK_FCM_SERVICE_ACCOUNT_PATH=/etc/morok/fcm-service-account.json
