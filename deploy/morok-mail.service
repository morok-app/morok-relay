[Unit]
Description=Morok Mail SMTP receiver (morok.email)
After=network.target postgresql.service redis-server.service

[Service]
Type=simple
User=morok
Group=morok
WorkingDirectory=/home/morok/morok-relay
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/morok/morok-relay/.venv/bin/python -m morok_relay.mail_smtp
Restart=always
RestartSec=3
# бінд на :25 без root
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/morok
PrivateTmp=true

[Install]
WantedBy=multi-user.target
