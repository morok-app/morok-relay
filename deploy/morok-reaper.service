[Unit]
Description=Morok blob reaper (secure-delete expired and delivered blobs)
After=morok-relay.service redis-server.service postgresql.service
Requires=redis-server.service

[Service]
Type=oneshot
User=morok
Group=morok
WorkingDirectory=/home/morok/morok-relay
EnvironmentFile=/home/morok/morok-relay/.env
ExecStart=/home/morok/morok-relay/.venv/bin/python -m morok_relay.scripts.reaper

# Same hardening as morok-relay.service
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/morok/morok-relay /var/lib/morok
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=morok-reaper

# This unit is started by morok-reaper.timer — no [Install] section needed.
