[Unit]
Description=Run Morok blob reaper (indexed, fast) every 5 minutes
Requires=morok-reaper.service

[Timer]
# Indexed прохід (MEDIUM, фрешевий аудит) — Redis ZRANGEBYSCORE, не
# filesystem scan. Дешевий: installer тримає той самий 5-хвилинний
# інтервал, що й раніше (див. emit_timer у deploy/install.sh — ЦЕЙ
# файл лише документує, як виглядає реально згенерований юніт).
OnBootSec=30s
OnUnitActiveSec=5min
AccuracySec=2s

# If the system was off when the timer should have fired, run it on boot
Persistent=true

Unit=morok-reaper.service

[Install]
WantedBy=timers.target
